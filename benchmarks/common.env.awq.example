# Copy to benchmarks/{model}/common.env.awq (gitignored) and edit paths.
# Basename must end in .awq so the harness matches PRECISION=awq.
# Matched A/B: Hub AWQ baseline vs Isiro TIC (Marlin W4A16 + densified leftovers).
#
#   ISIRO_BENCH_CONFIG=benchmarks/qwen3.6-27b-awq/common.env.awq \
#     benchmarks/run_ab.sh qwen3.6-27b-awq --no-reuse-baseline

BASELINE_MODEL_DIR=/path/to/Qwen3.6-27B-AWQ
TIC_MODEL_DIR=/path/to/Qwen3.6-27B-AWQ-TIC
MODEL_ID=QuantTrio/Qwen3.6-27B-AWQ

PRECISION=awq
SYSTEM_ID=rtx-5090
ISIRO_FORMAT=auto
ISIRO_RUNTIME=auto
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
API_PORT=8000

# Lean publish: weight integrity + serve output match (no NIAH grid).
ISIRO_BENCH_SKIP_NEEDLE=1
# Do not set ISIRO_VERIFY_REFERENCE=1 for large AWQ (27B+). Bit-exact -r
# decodes Hub+TIC on the host and can OOM / log out a desktop session.
# Harness refuses -r for PRECISION=awq or baseline+tic >=24 GiB unless
# ISIRO_BENCH_FORCE_VERIFY_R=1.

BENCH_SEED=17
PUBLISH_WARMUPS=10
PUBLISH_PROMPTS=40
PUBLISH_REPLICATES=1

# Match TIC serve.yaml on RTX 5090 (27B AWQ).
SERVE_MAX_MODEL_LEN=8192
SERVE_GPU_MEMORY_UTILIZATION=0.85
SERVE_TENSOR_PARALLEL_SIZE=1
SERVE_MAX_NUM_SEQS="${SERVE_MAX_NUM_SEQS:-8}"
SERVE_PREFIX_CACHING=false
SERVE_ENFORCE_EAGER=false
BENCH_MAX_CONCURRENCY="${BENCH_MAX_CONCURRENCY:-8}"
