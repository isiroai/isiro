# Copy to benchmarks/{model}/common.env.bf16.gdx-kv (gitignored) and edit paths.
# Matched A/B: baseline bf16 KV vs TIC + ISIRO_GDX=bf16 (auto-routes path_a on FA-paged GQA).
# Publish snapshot dir: benchmarks/{model}/rtx-5090-report-gdx-kv/
#
#   ISIRO_BENCH_CONFIG=benchmarks/qwen2.5-7b-instruct/common.env.bf16.gdx-kv \
#     benchmarks/run_ab.sh qwen2.5-7b-instruct

BASELINE_MODEL_DIR=/path/to/Qwen2.5-7B-Instruct
TIC_MODEL_DIR=/path/to/Qwen2.5-7B-Instruct-TIC
MODEL_ID=Qwen/Qwen2.5-7B-Instruct

PRECISION=bf16
SYSTEM_ID=rtx-5090
ISIRO_FORMAT=auto
ISIRO_RUNTIME=auto
VLLM_IMAGE=vllm/vllm-openai:v0.26.0
API_PORT=8000

# Fair KV alphabet with the original bf16 report (vendor bfloat16 pages).
SERVE_KV_CACHE_DTYPE=bfloat16
# Product dial (preferred). Legacy ISIRO_BENCH_GDX_KV still works as alphabet alias.
ISIRO_BENCH_GDX=bf16

BENCH_SEED=17
PUBLISH_WARMUPS=10
PUBLISH_PROMPTS=40
PUBLISH_REPLICATES=1

SERVE_MAX_MODEL_LEN=8192
# Needle window for KV-compress A/B (override if your GPU/stack allows longer).
NIAH_MAX_MODEL_LEN=8192
SERVE_GPU_MEMORY_UTILIZATION=0.90
SERVE_TENSOR_PARALLEL_SIZE=1
SERVE_MAX_NUM_SEQS="${SERVE_MAX_NUM_SEQS:-32}"
SERVE_PREFIX_CACHING=false
SERVE_ENFORCE_EAGER=false
BENCH_MAX_CONCURRENCY="${BENCH_MAX_CONCURRENCY:-32}"
