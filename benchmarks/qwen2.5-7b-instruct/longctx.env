# SPDX-License-Identifier: Apache-2.0
# Long-prefix overlay for KV-bound serve ITL (e2e_itl_vs_fa).
# Not Part B bf16/sak. Not v0.1.0 v10/v11.
# Example:
#   benchmarks/run_ab.sh qwen2.5-7b-instruct --config \
#     benchmarks/qwen2.5-7b-instruct/longctx.env \
#     --profiles=generation-16384-256
_HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.env
source "${_HERE}/common.env"
SERVE_MAX_MODEL_LEN=32768
ISIRO_BENCH_EQUAL_BATCH=0
