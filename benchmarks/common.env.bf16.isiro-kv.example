# Copy to benchmarks/{model}/common.env.bf16.isiro-kv (gitignored) and edit paths.
# Matched A/B: baseline bf16 KV vs Isiro (TIC weights + ISIRO_KV=bf16).
# Publish snapshot dir: benchmarks/{model}/rtx-5090-report/
#
#   ISIRO_BENCH_CONFIG=benchmarks/qwen2.5-7b-instruct/common.env.bf16.isiro-kv \
#     benchmarks/run_ab.sh qwen2.5-7b-instruct --no-reuse-baseline

BASELINE_MODEL_DIR=/path/to/Qwen2.5-7B-Instruct
TIC_MODEL_DIR=/path/to/Qwen2.5-7B-Instruct-TIC
MODEL_ID=Qwen/Qwen2.5-7B-Instruct

PRECISION=bf16
SYSTEM_ID=rtx-5090
ISIRO_FORMAT=auto
ISIRO_RUNTIME=auto
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
API_PORT=8000

# Fair KV alphabet with the original bf16 report (vendor bfloat16 pages).
SERVE_KV_CACHE_DTYPE=bfloat16
# Product dial: Isiro KV on the Isiro arm.
ISIRO_BENCH_KV=bf16
# Lean publish: weight + KV bit-exactness + serve output match (no NIAH grid).
ISIRO_BENCH_SKIP_NEEDLE=1
# Timed Isiro first; cold baseline on this VLLM_IMAGE (no reuse after Isiro).
ISIRO_BENCH_ISIRO_FIRST=1
ISIRO_VERIFY_REFERENCE=1

BENCH_SEED=17
PUBLISH_WARMUPS=10
PUBLISH_PROMPTS=40
PUBLISH_REPLICATES=1

SERVE_MAX_MODEL_LEN=8192
# Optional NIAH window when ISIRO_BENCH_SKIP_NEEDLE=0.
NIAH_MAX_MODEL_LEN=8192
SERVE_GPU_MEMORY_UTILIZATION=0.90
SERVE_TENSOR_PARALLEL_SIZE=1
SERVE_MAX_NUM_SEQS="${SERVE_MAX_NUM_SEQS:-32}"
SERVE_PREFIX_CACHING=false
SERVE_ENFORCE_EAGER=false
BENCH_MAX_CONCURRENCY="${BENCH_MAX_CONCURRENCY:-32}"
