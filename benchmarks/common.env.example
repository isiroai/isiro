# Copy to benchmarks/{model}/common.env (gitignored). Edit the three lines below.
BASELINE_MODEL_DIR=/path/to/baseline-hf-model
TIC_MODEL_DIR=/path/to/compiled-tic-bundle
MODEL_ID=org/model-name

PRECISION=bf16
SYSTEM_ID=rtx-5090
ISIRO_FORMAT=v0.1.0
VLLM_IMAGE=vllm/vllm-openai:v0.26.0
API_PORT=8000

BENCH_SEED=17
PUBLISH_WARMUPS=10
PUBLISH_PROMPTS=40
PUBLISH_REPLICATES=1

# Serve / capacity
SERVE_MAX_MODEL_LEN=4096
SERVE_GPU_MEMORY_UTILIZATION=0.90
SERVE_TENSOR_PARALLEL_SIZE=1
# Baseline max concurrent sequences. Default 32 suits 5090-class GPUs.
# Raise on larger GPUs with spare memory, e.g.:
#   SERVE_MAX_NUM_SEQS=64 BENCH_MAX_CONCURRENCY=64 benchmarks/run_ab.sh {model}
# Lower if baseline OOMs:
#   SERVE_MAX_NUM_SEQS=16 BENCH_MAX_CONCURRENCY=16 benchmarks/run_ab.sh {model}
SERVE_MAX_NUM_SEQS="${SERVE_MAX_NUM_SEQS:-32}"
SERVE_PREFIX_CACHING=false
# Graphs ON by default; use --graph-off to disable. Fallback if unset.
SERVE_ENFORCE_EAGER=false
# Timed concurrency floor; keep aligned with SERVE_MAX_NUM_SEQS.
BENCH_MAX_CONCURRENCY="${BENCH_MAX_CONCURRENCY:-32}"
