# Copy to benchmarks/{model}/common.env.fp8 (gitignored) and edit paths.
# Basename must end in .fp8 so the harness matches PRECISION=fp8.
# Matched A/B: Hub FP8 baseline vs Isiro (TIC weights + ISIRO_GDX=bf16).
# Publish snapshot dir: benchmarks/{model}/rtx-5090-report/
#
#   ISIRO_BENCH_CONFIG=benchmarks/gemma-4-12B-it-fp8/common.env.fp8 \
#     benchmarks/run_ab.sh gemma-4-12B-it-fp8 --no-reuse-baseline

BASELINE_MODEL_DIR=/path/to/gemma-4-12B-it-FP8
TIC_MODEL_DIR=/path/to/gemma-4-12B-it-FP8-TIC
MODEL_ID=google/gemma-4-12B-it

PRECISION=fp8
SYSTEM_ID=rtx-5090
ISIRO_FORMAT=auto
ISIRO_RUNTIME=auto
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
API_PORT=8000

# Fair KV alphabet with the bf16 GDX lean publish (vendor bfloat16 pages).
SERVE_KV_CACHE_DTYPE=bfloat16
ISIRO_BENCH_GDX=bf16
# Lean publish: weight + KV bit-exactness + serve output match (no NIAH grid).
ISIRO_BENCH_SKIP_NEEDLE=1
# Timed Isiro first; cold baseline on this VLLM_IMAGE (no reuse after Isiro).
ISIRO_BENCH_ISIRO_FIRST=1
ISIRO_VERIFY_REFERENCE=1

BENCH_SEED=17
PUBLISH_WARMUPS=10
PUBLISH_PROMPTS=40
PUBLISH_REPLICATES=1

SERVE_MAX_MODEL_LEN=8192
NIAH_MAX_MODEL_LEN=8192
SERVE_GPU_MEMORY_UTILIZATION=0.90
SERVE_TENSOR_PARALLEL_SIZE=1
SERVE_MAX_NUM_SEQS="${SERVE_MAX_NUM_SEQS:-32}"
SERVE_PREFIX_CACHING=false
SERVE_ENFORCE_EAGER=false
BENCH_MAX_CONCURRENCY="${BENCH_MAX_CONCURRENCY:-32}"

# Optional: bf16 twin for gdx_kv_bytes_curve when baseline is Hub FP8.
# ISIRO_BENCH_GDX_MODEL_DIR=/path/to/gemma-4-12B-it
