# Copy to benchmarks/glm-5.3-flash-nvfp4/common.env.fp8 (gitignored) and edit paths.
# Knobs match TIC serve.yaml used on vast-glm path_a_mla remeter:
#   tensor_parallel_size: 4
#   max_model_len: 8192
#   max_num_seqs: 10
#   max_num_batched_tokens: 8192
#   gpu_memory_utilization: 0.95
#   kv_cache_dtype: fp8
#   enable_flashinfer_autotune: false
#   no_enable_prefix_caching: true
# Plus remeter script: ISIRO_GDX=fp8, LIVE_WINDOW=512, enforce-eager,
# VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0, ISIRO_GDX_FP8_KV_SCALES_OK=1.
#
#   ISIRO_BENCH_CONFIG=benchmarks/glm-5.3-flash-nvfp4/common.env.fp8 \
#     benchmarks/run_ab.sh glm-5.3-flash-nvfp4 --no-reuse-baseline --enforce-eager

BASELINE_MODEL_DIR=/root/models/llm/fp4/GLM-5.3-Flash-NVFP4
TIC_MODEL_DIR=/root/models/llm/fp4/GLM-5.3-Flash-NVFP4-TIC
MODEL_ID=zai-org/GLM-5.3-Flash

# Harness PRECISION is bf16|fp8 (KV/serve dtype gate). Figure/report weight
# tagline for this NVFP4 bundle is nvfp4 (pass --weight-precision nvfp4).
PRECISION=fp8
SYSTEM_ID=rtx-pro-6000-blackwell
ISIRO_FORMAT=auto
ISIRO_RUNTIME=auto
# Ambient sm120 NoPE image (isiro-serve-native); override if docker A/B is used.
VLLM_IMAGE=cstechdev/vllm:glm53-flash-nope-sm120-cu130
API_PORT=8000

ISIRO_BENCH_GDX=fp8
ISIRO_BENCH_SKIP_NEEDLE=1
ISIRO_BENCH_ISIRO_FIRST=1
ISIRO_VERIFY_REFERENCE=1

# path_a_mla KV-bytes curve: [L,T,D] uint8 capture (T>=100k for hot amortize).
ISIRO_BENCH_MLA_LATENT_NPZ=/workspace/logs/mla_latent_real_t100k.npz
export ISIRO_GDX_LIVE_WINDOW=512
export ISIRO_GDX_FP8_KV_SCALES_OK=1
export VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0

BENCH_SEED=17
PUBLISH_WARMUPS=10
PUBLISH_PROMPTS=40
PUBLISH_REPLICATES=1

SERVE_MAX_MODEL_LEN=8192
NIAH_MAX_MODEL_LEN=8192
SERVE_GPU_MEMORY_UTILIZATION=0.95
SERVE_TENSOR_PARALLEL_SIZE=4
SERVE_MAX_NUM_SEQS=10
SERVE_MAX_NUM_BATCHED_TOKENS=8192
SERVE_PREFIX_CACHING=false
SERVE_ENFORCE_EAGER=true
SERVE_KV_CACHE_DTYPE=fp8
BENCH_MAX_CONCURRENCY=10
